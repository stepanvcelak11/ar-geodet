<?xml version="1.0"?>
<!--
    AR Geodet — hodinky (Garmin Forerunner 255)
    Zjednodušený pomocník k mobilní aplikaci: mapka okolních bodů,
    seznam od nejbližšího, navigace k bodu a zakládání nových bodů.

    Zatím pracuje čistě offline — body vznikají a žijí v hodinkách.
    Synchronizace s mobilem (přes Cloudflare Worker) přijde jako další krok;
    až bude, přibude sem oprávnění "Communications".
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="ArGeodetApp"
        id="6121707be82d4d7d8b2a413e0937e747"
        launcherIcon="@Drawables.LauncherIcon"
        name="@Strings.AppName"
        type="watch-app"
        minApiLevel="3.2.0">

        <iq:products>
            <iq:product id="fr255"/>
            <iq:product id="fr255s"/>
            <iq:product id="fr255m"/>
            <iq:product id="fr255sm"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Sensor"/>
            <!-- přenos bodů z/do mobilu přes Cloudflare Worker (source/Cloud.mc) -->
            <iq:uses-permission id="Communications"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
